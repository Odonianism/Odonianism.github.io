---
interface Props {
  title: string;
  description?: string;
}

const { title, description = '阅读、写作，以及关于如何共同生活的思考。' } = Astro.props;
const navigation = [
  { label: '首页', href: '/' },
  { label: '关于', href: '/about/' },
  { label: '简介', href: '/bio/' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f2ec" />
    <title>{title} · 奥多主义</title>
  </head>
  <body>
    <div class="site-shell">
      <header id="top" class="site-header">
        <a class="brand" href="/" aria-label="奥多主义首页">
          <span class="brand-mark" aria-hidden="true">O</span>
          <span class="brand-name">奥多主义</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <span class="header-note">思想 · 阅读 · 日常</span>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <a class="footer-brand" href="/">奥多主义</a>
        <span>在不确定中，继续思考。</span>
        <a href="#top" onclick="window.scrollTo({ top: 0, behavior: 'smooth' }); return false;">回到顶部 ↑</a>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family: "Noto Serif SC", "Songti SC", "STSong", Georgia, serif;
    color: #24251f;
    background: #f5f2ec;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    --ink: #24251f;
    --muted: #76766e;
    --paper: #fbfaf7;
    --line: #dedbd2;
    --accent: #a74f35;
    --serif: "Noto Serif SC", "Songti SC", "STSong", Georgia, serif;
    --sans: "Inter", "Helvetica Neue", Arial, sans-serif;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body { margin: 0; }

  a { color: inherit; text-decoration: none; }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .site-shell {
    width: min(100% - 64px, 1160px);
    margin-inline: auto;
  }

  .site-header {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    gap: 24px;
  }

  .brand { display: inline-flex; align-items: center; gap: 12px; }

  .brand-mark {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid var(--accent);
    border-radius: 50%;
    color: var(--accent);
    font: italic 21px Georgia, serif;
  }

  .brand-name, .footer-brand { font-size: 18px; font-weight: 700; letter-spacing: .08em; }

  .site-nav { display: flex; gap: 34px; margin-left: auto; }

  .site-nav a, .header-note, .site-footer {
    font: 12px/1.6 var(--sans);
    letter-spacing: .08em;
  }

  .site-nav a { color: #56574f; transition: color .2s ease; }
  .site-nav a:hover, .site-footer a:hover { color: var(--accent); }
  .header-note { color: var(--muted); }

  main { min-height: 70vh; }

  .site-footer {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: 80px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .site-footer .footer-brand { color: var(--ink); font: 700 14px var(--serif); }

  .eyebrow {
    margin: 0 0 18px;
    color: var(--accent);
    font: 11px/1.5 var(--sans);
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .page-heading {
    margin: 0;
    font-size: clamp(32px, 5vw, 58px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -.045em;
  }

  .prose {
    color: #45463f;
    font-size: 16px;
    line-height: 2;
    overflow-wrap: anywhere;
  }

  .prose h2, .prose h3 {
    margin: 2.3em 0 .7em;
    color: var(--ink);
    font-weight: 600;
    line-height: 1.45;
  }

  .prose h2 { font-size: 24px; }
  .prose h3 { font-size: 19px; }
  .prose p { margin: 0 0 1.35em; }
  .prose blockquote {
    margin: 2em 0;
    padding: .2em 0 .2em 1.2em;
    border-left: 2px solid var(--accent);
    color: #66675f;
  }
  .prose img { display: block; max-width: 100%; height: auto; margin: 2em auto; }
  .prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .prose hr { margin: 2em 0; border: 0; border-top: 1px solid var(--line); }

  @media (max-width: 680px) {
    .site-shell { width: min(100% - 36px, 1160px); }
    .site-header { min-height: 74px; flex-wrap: wrap; gap: 12px; padding-block: 14px; }
    .site-nav { order: 3; width: 100%; gap: 24px; margin: 0; }
    .header-note { margin-left: auto; font-size: 10px; }
    .site-footer { min-height: 100px; align-items: flex-start; flex-direction: column; justify-content: center; gap: 4px; margin-top: 52px; padding-block: 20px; }
  }
</style>
